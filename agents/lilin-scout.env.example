# ~/.config/lilin-scout.env for agents/lilin-scout (chmod 600: it holds the token)
# Lilin's address and its SCOUT_TOKEN (from Lilin's .env)
LILIN_URL=http://192.168.1.20:8080
SCOUT_TOKEN=
# A clone of Lilin on this machine: the scout reads docs from origin/master; builds branch from it
SCOUT_REPO=~/src/lilin
# Where build worktrees go (one per accepted idea)
SCOUT_WORKTREES=~/lilin-builds
# Extra files the research reads so it doesn't suggest work already planned (":"-separated)
SCOUT_CONTEXT=
# House rules for build agents: how to ship, deploy and hand over (a Markdown file). Blank = push the branch only.
SCOUT_RULES=
# A command that gets one text argument: how the scout tells you about new ideas and builds
SCOUT_NOTIFY=
# No research or builds while one of these processes runs (space-separated)
SCOUT_BUSY=cs2
# Ideas per research run (1-6)
SCOUT_IDEAS=4
# Claude Code settings (blank model = the account's default)
SCOUT_MODEL=
SCOUT_EFFORT=high
SCOUT_BUILD_EFFORT=xhigh
SCOUT_PERMISSION_MODE=auto
SCOUT_BUILD_HOURS=8
