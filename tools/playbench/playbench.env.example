# Copy to ~/.config/lilin-playbench/playbench.env (or point PLAYBENCH_ENV at it). Never commit the real one.
# The server as a viewer at home reaches it:
LILIN_URL=http://192.0.2.10:8080
# A dedicated test account (its downloads land in its library). Create it once: sign in through your proxy as this
# email and pick a password, or `node setup.js user add`.
LILIN_EMAIL=playbench@example.invalid
LILIN_PASSWORD=change-me
# Optional, Windows servers: ssh alias for the read-only background sampler (copy server-sampler.ps1 there first)
#PLAYBENCH_SSH=my-lilin-server
#PLAYBENCH_SAMPLER=C:\Users\Public\playbench-sampler.ps1
